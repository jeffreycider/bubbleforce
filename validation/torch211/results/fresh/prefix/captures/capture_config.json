{
  "optimizer_groups": [
    {
      "pattern": "^embed\\.weight$",
      "optimizer": "adamw",
      "hyperparams": {
        "lr": 0.7,
        "weight_decay": 0.001
      },
      "lr_schedule": {
        "kind": "cooldown",
        "fraction": 0.7
      }
    },
    {
      "pattern": "^proj\\.weight$",
      "optimizer": "adamw",
      "hyperparams": {
        "lr": 0.004,
        "weight_decay": 0.001
      },
      "lr_schedule": {
        "kind": "cooldown",
        "fraction": 0.7
      }
    },
    {
      "pattern": "^blocks\\..*\\.weight$",
      "optimizer": "muon",
      "hyperparams": {
        "lr": 0.025,
        "weight_decay": 0.05,
        "momentum": {
          "kind": "ema",
          "decay": 0.95,
          "nesterov_mix": 0.95
        }
      },
      "lr_schedule": {
        "kind": "cooldown",
        "fraction": 0.7
      }
    },
    {
      "pattern": "^(?!embed\\.weight$|proj\\.weight$|blocks\\..*\\.weight$).*",
      "optimizer": "adamw",
      "hyperparams": {
        "lr": 0.015,
        "weight_decay": 0.001
      },
      "lr_schedule": {
        "kind": "cooldown",
        "fraction": 0.7
      }
    }
  ],
  "loop": "gpt_record",
  "seed": 0,
  "minibatch_seed": 0,
  "batch_tokens": 4096,
  "microbatch_sequences": 1,
  "train_data": "data/fineweb10B/fineweb_train_*.bin",
  "val_data": "data/fineweb10B/fineweb_val_*.bin",
  "val_tokens": 2048,
  "run_id": "original_implementation",
  "output_dir": "/workspace/validation211/fresh/prefix/training",
  "resume_checkpoint": null,
  "model": {
    "vocab_size": 50304,
    "num_layers": 2,
    "model_dim": 128
  },
  "train_steps": 6,
  "stop_step": 3,
  "setup": [
    {
      "name": "open_rank_zero_log"
    },
    {
      "name": "load_validation_tokens"
    },
    {
      "name": "build_compiled_gpt"
    },
    {
      "name": "seed_then_initialize_parameters"
    },
    {
      "name": "assemble_grouped_optimizer"
    },
    {
      "name": "restore_checkpoint"
    },
    {
      "name": "open_training_batches"
    },
    {
      "name": "broadcast_initial_parameters"
    },
    {
      "name": "validate_at_step_boundaries"
    }
  ],
  "pre_optimizer": [
    {
      "name": "schedule_optimizer_groups"
    }
  ],
  "post_optimizer": [
    {
      "name": "print_training_progress"
    },
    {
      "name": "validate_at_step_boundaries",
      "hyperparams": {
        "every": 125,
        "final_tenth_every": 25
      }
    }
  ],
  "teardown": [
    {
      "name": "mark_log_finished"
    }
  ],
  "wandb_offline": true,
  "initialization": {
    "zero_projection": true,
    "weight_scales": {}
  },
  "seed_offset": 1337,
  "reseed_before_initialization": true,
  "checkpoint": {
    "every": 3
  },
  "metrics_snapshot": {
    "quantities": [
      "weights",
      "momentum"
    ],
    "steps": [
      2
    ]
  },
  "capture_dir": "/workspace/validation211/fresh/prefix/captures",
  "require_world_size": 2,
  "format": 3,
  "ring_length": 256,
  "clock": "snapshot t describes update t; checkpoint N is before update N"
}